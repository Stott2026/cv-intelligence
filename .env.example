# Copy this file to .env for local use. Never commit .env.
# On Railway, set these as service variables instead.

# Anthropic API key (Claude Console > API keys). Used by the server only; never sent to the browser.
ANTHROPIC_API_KEY=

# Sign-in goes through the House (the front door to every Stott and May tool): people sign in there
# once and arrive here signed in. Its address, e.g. https://the-house-production-e96c7a55.up.railway.app.
# Also shows a "The House" button in the top bar.
HOUSE_URL=

# Optional: a long random string that signs this tool's sign-in cookie. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, one is made each time the app starts (people just go through the House again).
# SESSION_SECRET=

# BACKUP ONLY, if the House is down: set BACKUP_ACCESS_CODE=true and the shared access code below
# works again. Leave it off otherwise.
ACCESS_CODE=
# BACKUP_ACCESS_CODE=true

# Optional: flag companies we already have Terms with, from Client Radar (stott2026/client-radar).
# CLIENT_RADAR_URL is Client Radar's address; TERMS_FEED_KEY is the same value as TERMS_FEED_KEY
# in Client Radar's Railway variables. Leave either empty to turn the badges off.
# CLIENT_RADAR_URL=https://client-radar-production.up.railway.app
# TERMS_FEED_KEY=

# Optional: the Claude model. Default claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5


# Optional: port for local use. Railway sets this itself.
# PORT=3000
