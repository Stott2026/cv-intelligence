# Copy this file to .env for local use. Never commit .env.
# On Railway, set these as service variables instead.

# Anthropic API key (Claude Console > API keys). Used by the server only; never sent to the browser.
ANTHROPIC_API_KEY=

# The code consultants type to use the app. Share it with the team, change it if it leaks.
ACCESS_CODE=

# Optional: the Claude model. Default claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: the House's address (the front door to every Stott and May tool), e.g.
# https://the-house-production-e96c7a55.up.railway.app. When set, a "The House" button in the
# top bar goes back to its hallway. Leave empty to hide the button.
# HOUSE_URL=

# Optional: port for local use. Railway sets this itself.
# PORT=3000
